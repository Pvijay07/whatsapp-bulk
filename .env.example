# Production Environment Configuration

# Server
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Security & Secrets
JWT_SECRET=replace_with_a_super_secure_random_string_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_another_super_secure_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# PostgreSQL Database
DATABASE_URL=postgresql://messaging_user:SecurePassword123!@postgres:5432/messaging?schema=public
POSTGRES_DB=messaging
POSTGRES_USER=messaging_user
POSTGRES_PASSWORD=SecurePassword123!

# Redis (BullMQ & Cache)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# WhatsApp Messaging Provider (Meta Cloud API / BSP)
WHATSAPP_PROVIDER=meta_cloud # meta_cloud | gupshup | 360dialog | mock
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_TOKEN=EAAB...your_meta_system_user_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WEBHOOK_APP_SECRET=your_meta_app_secret_for_signature_verification

# Number Provider (Licensed Indian Cloud Telephony / DID)
NUMBER_PROVIDER=exotel # exotel | tata | airtel | mock
NUMBER_PROVIDER_API_KEY=your_exotel_api_key
NUMBER_PROVIDER_API_TOKEN=your_exotel_api_token
NUMBER_PROVIDER_ACCOUNT_SID=your_exotel_sid

# Payment Gateway (for Prepaid Wallet Top-ups)
PAYMENT_GATEWAY=cashfree # cashfree | razorpay
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST # TEST | PRODUCTION

# Storage (S3 / R2 for Media & Contact CSVs)
STORAGE_DRIVER=local # local | s3
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_key
S3_SECRET_ACCESS_KEY=your_secret
S3_BUCKET_NAME=whatsapp-saas-media

